# Copy this file as your base for environment-specific config, then fill in
# your real values. It is NOT committed with values — keep this template a
# placeholder only.
#
#   cp .env.example .env.development   # local dev
#   cp .env.example .env.production    # production deploy
#
# .env.development and .env.production are gitignored (see .gitignore).

# Shopify app credentials (https://partners.shopify.com)
# Required — app fails to boot without these when running the Rails server.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of your app; must be reachable by Shopify webhooks and the Midtrans
# HTTP(S) Notification URL (e.g. https://yourapp.example.com or a tunnel URL).
HOST=

# Only required for private-store installs
# SHOPIFY_APP_PRIVATE_SHOP=

# Billing test charges
# SHOPIFY_TEST_CHARGES=

# ---- Midtrans (upstream hosted payment gateway) ----
# Server key used as the Basic-Auth username for the Snap API and to verify the
# notification signature_key (SHA512).
MIDTRANS_SERVER_KEY=
# Client key for the Snap payment page. Only needed if the frontend ever
# switches from redirect mode to the snap.js popup.
MIDTRANS_CLIENT_KEY=
# Set to "true" to hit production (https://app.midtrans.com); leave false to use
# the sandbox (https://app.sandbox.midtrans.com).
MIDTRANS_IS_PRODUCTION=false
